# Copier en .env sur le serveur (jamais commité) et remplir avec de vraies valeurs.
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=change-me
# Générer avec: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change-me
# Générer avec: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_WEBSERVER_SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=change-me
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=change-me@example.com
# Role dbt_transform sur l'entrepot (entrepot/init/01_schema_raw.sql) --
# meme mot de passe que docs/housekeeping/.env (DBT_PASSWORD), lu par
# dbt/profiles.yml via PGPASSWORD.
DBT_PASSWORD=change-me
