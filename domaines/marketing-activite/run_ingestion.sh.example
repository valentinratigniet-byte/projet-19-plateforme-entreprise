#!/bin/bash
# Copier en run_ingestion.sh sur le serveur (jamais commité), remplir les
# mots de passe reels. Appele par le workflow n8n (SSH node).
set -euo pipefail

docker run --rm \
  --network entrepot_default \
  -v /opt/projet19/domaines/marketing-activite:/domain \
  -e PYTHONPATH=/app \
  -e PGHOST=projet19-postgres -e PGPORT=5432 -e PGDATABASE=projet19 \
  -e PGUSER=ingestion -e PGPASSWORD=change-me \
  -e MYSQL_HOST=projet19-mysql -e MYSQL_PORT=3306 \
  -e MYSQL_ROOT_PASSWORD=change-me \
  -e SAAS_BASE_URL=http://projet19-saas-mock:5000 \
  -e SAAS_CLIENT_SECRET=change-me \
  -w /domain \
  projet19-ingestion python ingestion.py
