#!/bin/bash
# Copier en run_rgpd_anonymiser.sh sur le serveur (jamais commité).
# Usage: bash run_rgpd_anonymiser.sh <email>
# Appele par le workflow n8n "Traitement demande RGPD" (webhook), email
# pris dans le payload recu.
set -euo pipefail

EMAIL="$1"

docker run --rm \
  --network entrepot_default \
  -v /opt/projet19/domaines/marketing-activite:/domain \
  -e PGHOST=projet19-postgres -e PGPORT=5432 -e PGDATABASE=projet19 \
  -e PGUSER=ingestion -e PGPASSWORD=change-me \
  -w /domain \
  projet19-ingestion python rgpd_anonymiser.py "$EMAIL"
