#!/bin/bash
# Copier en run_ingestion.sh sur le serveur (jamais commité), remplir le
# mot de passe reel. Appele par le workflow n8n (SSH node) -- garde le
# secret hors du JSON du workflow, un seul endroit a mettre a jour.
set -euo pipefail

docker run --rm \
  --network entrepot_default \
  -v /opt/projet19/domaines/ventes-commerce:/domain \
  -e PYTHONPATH=/app \
  -e PGHOST=projet19-postgres -e PGPORT=5432 -e PGDATABASE=projet19 \
  -e PGUSER=ingestion -e PGPASSWORD=change-me \
  -w /domain \
  projet19-ingestion python ingestion.py
