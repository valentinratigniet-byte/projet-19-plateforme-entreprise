#!/bin/bash
# Copier en run_digest_transverse.sh sur le serveur (jamais commité).
# Appele par le workflow n8n "Digest hebdomadaire transverse".
set -euo pipefail

mkdir -p /opt/projet19/ops/logs

{
  docker run --rm \
    --network entrepot_default \
    -v /opt/projet19/ops:/domain \
    -e PGHOST=projet19-postgres -e PGPORT=5432 -e PGDATABASE=projet19 \
    -e PGUSER=dbt_transform -e PGPASSWORD=change-me \
    -w /domain \
    projet19-ingestion python digest_transverse.py
  echo
} >> /opt/projet19/ops/logs/digest.log 2>&1
