#!/bin/bash
# Copier en run_verifier_derive_qualite.sh sur le serveur (jamais
# commité). Appele par le workflow n8n "Alerte derive qualite".
set -euo pipefail

mkdir -p /opt/projet19/ops/logs

{
  echo "=== $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  docker run --rm \
    --network entrepot_default \
    -v /opt/projet19/ops:/domain \
    -e PGHOST=projet19-postgres -e PGPORT=5432 -e PGDATABASE=projet19 \
    -e PGUSER=dbt_transform -e PGPASSWORD=change-me \
    -w /domain \
    projet19-ingestion python verifier_derive_qualite.py
  echo
} >> /opt/projet19/ops/logs/derive_qualite.log 2>&1
