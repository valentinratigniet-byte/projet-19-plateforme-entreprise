#!/bin/bash
# Copier en run_reverse_etl.sh sur le serveur (jamais commité), remplir
# les vrais secrets (identiques a domaines/marketing-activite/source/.env
# et saas-mock/.env). Appele par le workflow n8n "Reverse ETL planifie".
set -euo pipefail

docker run --rm \
  --network entrepot_default \
  -v /opt/projet19/domaines/marketing-activite:/domain \
  -e PYTHONPATH=/app \
  -e PGHOST=projet19-postgres -e PGPORT=5432 -e PGDATABASE=projet19 \
  -e PGUSER=dbt_transform -e PGPASSWORD=change-me \
  -e SAAS_BASE_URL=http://projet19-saas-mock:5000 \
  -e SAAS_CLIENT_ID=projet19 -e SAAS_CLIENT_SECRET=change-me \
  -w /domain \
  projet19-ingestion python reverse_etl.py
